{
  "name": "ani-rpg-bot",
  "version": "1.0.0",
  "description": "WhatsApp RPG Bot using Baileys",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "ui:open": "node -e \"const {exec}=require('child_process');const url=process.env.ASTRALINK_URL||('http://localhost:'+(process.env.PORT||3000));const opener=process.platform==='win32'?'start':process.platform==='darwin'?'open':'xdg-open';exec(`${opener} ${url}`);\"",
    "ui:dev": "node -e \"console.log('Open http://localhost:'+(process.env.PORT||3000)+' in your browser.\\nThe UI is served directly by the bot at that URL.');\""
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "canvas": "^2.11.2",
    "dotenv": "^16.4.5",
    "imagemin-webp": "^8.0.0",
    "mongodb": "^6.0.0",
    "node-webpmux": "^3.2.1",
    "pino": "^8.21.0",
    "play-dl": "^1.9.7",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
