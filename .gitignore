# ═══════════════════════════════════════════════════════════════
# AniRPG — Git Ignore
# ═══════════════════════════════════════════════════════════════
# IMPORTANT: This file is the last line of defense against
# accidentally committing secrets. Keep it updated!

# ── Secrets — NEVER commit these ─────────────────────────────
.env
.env.*
*.env
!.env.example

# ── Auth state — WhatsApp session keys (extremely sensitive) ─
auth/
/auth
data/auth/
/data/auth

# ── Runtime data — generated by the bot ──────────────────────
# Whole runtime folders — never commit these (contain real player data).
database/
/database
/data
rpg/server/
# rpg/data has BOTH static code (recipes_*.js etc — KEEP) and live per-player
# .json that must never be shared on a public repo. Ignore only the .json.
rpg/data/*.json
/database/database.json
database/*.tmp
database/*.backup.json
*.pid

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log
.pnpm-debug.log

# ── Build artifacts ─────────────────────────────────────────
dist/
build/
out/
.next/
.cache/

# ── IDE / OS ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Test coverage ───────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Fly.io ───────────────────────────────────────────────────
.fly/

# ── Misc ─────────────────────────────────────────────────────
*.local
tmp/
temp/
